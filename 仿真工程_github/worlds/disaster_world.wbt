# ============================================================
# 机器人 — 北岸硬质路面出发，朝南行驶
# ============================================================

Robot {
  translation -9 18 0.3
  rotation 0 0 1 0
  name "RescueRobot"
  controller "robot_controller"
  supervisor TRUE
  physics Physics { density 150 }
  boundingObject Transform {
    translation 0 0 0.25
    children [ Box { size 0.8 1.2 0.3 } ]
  }
  battery [ 360000 360000 5 ]

  children [
    Solid {
      translation 0 0 0.25
      name "body"
      children [
        Shape {
          geometry Box { size 0.8 1.2 0.3 }
          appearance Appearance { material Material { diffuseColor 0.2 0.6 0.2 } }
        }
      ]
    }

    Solid {
      translation -0.5 0 0
      name "left_pontoon"
      physics Physics { density 300 }
      children [
        Transform {
          rotation 1 0 0 1.57
          children [
            Shape {
              geometry Cylinder { radius 0.12 height 1.1 }
              appearance Appearance { material Material { diffuseColor 1 0.6 0 } }
            }
          ]
        }
      ]
      boundingObject Transform {
        rotation 1 0 0 1.57
        children [ Cylinder { radius 0.12 height 1.1 } ]
      }
    }

    Solid {
      translation 0.5 0 0
      name "right_pontoon"
      physics Physics { density 300 }
      children [
        Transform {
          rotation 1 0 0 1.57
          children [
            Shape {
              geometry Cylinder { radius 0.12 height 1.1 }
              appearance Appearance { material Material { diffuseColor 1 0.6 0 } }
            }
          ]
        }
      ]
      boundingObject Transform {
        rotation 1 0 0 1.57
        children [ Cylinder { radius 0.12 height 1.1 } ]
      }
    }

    # ═══ 臂摆履带 v3 — 臂=连杆(前轮+第一滚轮)，初始水平，微幅摆动 ═══
    # 前臂: 连接驱动轮(r=12cm)+第一滚轮(r=15cm), 默认水平, 范围±20°
    # 后臂: 连接驱动轮(r=12cm)+最后滚轮(r=15cm), 默认水平, 范围±20°
    # 中间滚轮×4: 直接装在车身上, r=15cm密集排列
    # 前后轮小→自然3cm仰角, 臂微摆→履带变形越障

    # ── 左前臂 ──
    HingeJoint {
      jointParameters HingeJointParameters { anchor -0.3 -0.5 -0.15 axis 1 0 0 springConstant 80 dampingConstant 15 }
      device RotationalMotor { name "arm_fl" maxTorque 5 minPosition -0.35 maxPosition 0.35 }
      endPoint Solid {
        translation -0.3 -0.5 -0.15
        name "arm_body_fl"
        children [
          Transform { translation 0 -0.16 0.0 children [ Shape { geometry Box { size 0.05 0.32 0.04 } appearance Appearance { material Material { diffuseColor 0.35 0.35 0.4 } } } ] }
          # 第一滚轮 r=15cm (距 pivot 20cm)
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 -0.15 -0.01 }
            device RotationalMotor { name "drive_L1" maxTorque 80 }
            endPoint Solid {
              translation 0 -0.15 -0.01 rotation 0 1 0 1.57 name "r_L1"
              children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ]
              boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 }
            }
          }
          # 前驱动轮 r=12cm (距 pivot 44cm)
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 -0.32 -0.01 }
            device RotationalMotor { name "wheel_fl" maxTorque 80 }
            endPoint Solid {
              translation 0 -0.32 -0.01 rotation 0 1 0 1.57 name "wh_fl"
              children [ Shape { geometry Cylinder { radius 0.12 height 0.08 } appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } } } ]
              boundingObject Cylinder { radius 0.12 height 0.08 } physics Physics { density 800 }
            }
          }
        ]
        boundingObject Transform { translation 0 -0.16 0.0 children [ Box { size 0.05 0.32 0.04 } ] }
        physics Physics { density 400 }
      }
    }
    # ── 右前臂 ──
    HingeJoint {
      jointParameters HingeJointParameters { anchor 0.3 -0.5 -0.15 axis 1 0 0 springConstant 80 dampingConstant 15 }
      device RotationalMotor { name "arm_fr" maxTorque 5 minPosition -0.35 maxPosition 0.35 }
      endPoint Solid {
        translation 0.3 -0.5 -0.15
        name "arm_body_fr"
        children [
          Transform { translation 0 -0.16 0.0 children [ Shape { geometry Box { size 0.05 0.32 0.04 } appearance Appearance { material Material { diffuseColor 0.35 0.35 0.4 } } } ] }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 -0.15 -0.01 }
            device RotationalMotor { name "drive_R1" maxTorque 80 }
            endPoint Solid {
              translation 0 -0.15 -0.01 rotation 0 1 0 1.57 name "r_R1"
              children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ]
              boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 }
            }
          }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 -0.32 -0.01 }
            device RotationalMotor { name "wheel_fr" maxTorque 80 }
            endPoint Solid {
              translation 0 -0.32 -0.01 rotation 0 1 0 1.57 name "wh_fr"
              children [ Shape { geometry Cylinder { radius 0.12 height 0.08 } appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } } } ]
              boundingObject Cylinder { radius 0.12 height 0.08 } physics Physics { density 800 }
            }
          }
        ]
        boundingObject Transform { translation 0 -0.16 0.0 children [ Box { size 0.05 0.32 0.04 } ] }
        physics Physics { density 400 }
      }
    }
    # ── 左后臂 ──
    HingeJoint {
      jointParameters HingeJointParameters { anchor -0.3 0.5 -0.15 axis 1 0 0 springConstant 80 dampingConstant 15 }
      device RotationalMotor { name "arm_rl" maxTorque 5 minPosition -0.35 maxPosition 0.35 }
      endPoint Solid {
        translation -0.3 0.5 -0.15
        name "arm_body_rl"
        children [
          Transform { translation 0 0.16 0.0 children [ Shape { geometry Box { size 0.05 0.32 0.04 } appearance Appearance { material Material { diffuseColor 0.35 0.35 0.4 } } } ] }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 0.15 -0.01 }
            device RotationalMotor { name "drive_L6" maxTorque 80 }
            endPoint Solid {
              translation 0 0.15 -0.01 rotation 0 1 0 1.57 name "r_L6"
              children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ]
              boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 }
            }
          }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 0.32 -0.01 }
            device RotationalMotor { name "wheel_rl" maxTorque 80 }
            endPoint Solid {
              translation 0 0.32 -0.01 rotation 0 1 0 1.57 name "wh_rl"
              children [ Shape { geometry Cylinder { radius 0.12 height 0.08 } appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } } } ]
              boundingObject Cylinder { radius 0.12 height 0.08 } physics Physics { density 800 }
            }
          }
        ]
        boundingObject Transform { translation 0 0.16 0.0 children [ Box { size 0.05 0.32 0.04 } ] }
        physics Physics { density 400 }
      }
    }
    # ── 右后臂 ──
    HingeJoint {
      jointParameters HingeJointParameters { anchor 0.3 0.5 -0.15 axis 1 0 0 springConstant 80 dampingConstant 15 }
      device RotationalMotor { name "arm_rr" maxTorque 5 minPosition -0.35 maxPosition 0.35 }
      endPoint Solid {
        translation 0.3 0.5 -0.15
        name "arm_body_rr"
        children [
          Transform { translation 0 0.16 0.0 children [ Shape { geometry Box { size 0.05 0.32 0.04 } appearance Appearance { material Material { diffuseColor 0.35 0.35 0.4 } } } ] }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 0.15 -0.01 }
            device RotationalMotor { name "drive_R6" maxTorque 80 }
            endPoint Solid {
              translation 0 0.15 -0.01 rotation 0 1 0 1.57 name "r_R6"
              children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ]
              boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 }
            }
          }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 0.32 -0.01 }
            device RotationalMotor { name "wheel_rr" maxTorque 80 }
            endPoint Solid {
              translation 0 0.32 -0.01 rotation 0 1 0 1.57 name "wh_rr"
              children [ Shape { geometry Cylinder { radius 0.12 height 0.08 } appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } } } ]
              boundingObject Cylinder { radius 0.12 height 0.08 } physics Physics { density 800 }
            }
          }
        ]
        boundingObject Transform { translation 0 0.16 0.0 children [ Box { size 0.05 0.32 0.04 } ] }
        physics Physics { density 400 }
      }
    }

    # ── 车身中间滚轮 r=15cm (4个/侧, 桥接前后臂滚轮) ──
    HingeJoint { jointParameters HingeJointParameters { anchor -0.3 -0.42 -0.16 } device RotationalMotor { name "drive_L2" maxTorque 80 } endPoint Solid { translation -0.3 -0.42 -0.16 rotation 0 1 0 1.57 name "r_L2" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor -0.3 -0.18 -0.16 } device RotationalMotor { name "drive_L3" maxTorque 80 } endPoint Solid { translation -0.3 -0.18 -0.16 rotation 0 1 0 1.57 name "r_L3" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor -0.3  0.06 -0.16 } device RotationalMotor { name "drive_L4" maxTorque 80 } endPoint Solid { translation -0.3  0.06 -0.16 rotation 0 1 0 1.57 name "r_L4" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor -0.3  0.30 -0.16 } device RotationalMotor { name "drive_L5" maxTorque 80 } endPoint Solid { translation -0.3  0.30 -0.16 rotation 0 1 0 1.57 name "r_L5" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor  0.3 -0.42 -0.16 } device RotationalMotor { name "drive_R2" maxTorque 80 } endPoint Solid { translation  0.3 -0.42 -0.16 rotation 0 1 0 1.57 name "r_R2" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor  0.3 -0.18 -0.16 } device RotationalMotor { name "drive_R3" maxTorque 80 } endPoint Solid { translation  0.3 -0.18 -0.16 rotation 0 1 0 1.57 name "r_R3" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor  0.3  0.06 -0.16 } device RotationalMotor { name "drive_R4" maxTorque 80 } endPoint Solid { translation  0.3  0.06 -0.16 rotation 0 1 0 1.57 name "r_R4" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }
    HingeJoint { jointParameters HingeJointParameters { anchor  0.3  0.30 -0.16 } device RotationalMotor { name "drive_R5" maxTorque 80 } endPoint Solid { translation  0.3  0.30 -0.16 rotation 0 1 0 1.57 name "r_R5" children [ Shape { geometry Cylinder { radius 0.15 height 0.08 } appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } } } ] boundingObject Cylinder { radius 0.15 height 0.08 } physics Physics { density 500 } } }

    # ── RGB相机云台 (车前, 可左右转动 ±45°) ──
    Camera {
      translation 0 -0.65 0.6
      rotation 0 0 1 -1.57
      name "rgb_camera"
      width 640 height 480 fieldOfView 1.2
    }

    Camera {
      translation 0 -0.62 0.65
      rotation 0 0 1 -1.57
      name "ir_camera"
      width 640 height 480 fieldOfView 1.2
    }

    GPS {
      translation 0 0 0.3
      name "gps"
    }

    DistanceSensor {
      translation 0 0.5 0.3
      rotation 0 0 1 1.57
      name "depth_sensor"
      type "laser"
      numberOfRays 1
      aperture 0.1
    }

    Accelerometer {
      name "imu_accel"
    }

    Gyro {
      name "imu_gyro"
    }

    # ── 毫米波雷达 (穿透烟/雾, 测距测速) ──
    Radar {
      translation 0 -0.55 0.55
      rotation 0 0 1 -1.57
      name "radar"
      minRange 0.5
      maxRange 30
      horizontalFieldOfView 2.0
      verticalFieldOfView 0.8
      rangeNoise 0.05
      speedNoise 0.1
    }

    # ── 激光雷达 (3D点云, 主动发光不受暗影响) ──
    Lidar {
      translation 0 -0.5 0.60
      rotation 0 0 1 -1.57
      name "lidar"
      type "fixed"
      minRange 0.3
      maxRange 20
      fieldOfView 1.2
      horizontalResolution 64
      numberOfLayers 16
      noise 0.02
    }

    LED {
      translation 0 0 0.55
      name "beacon_light"
    }
  ]
}
