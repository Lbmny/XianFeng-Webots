#VRML_SIM R2025a utf8

WorldInfo {
  title "Disaster Rescue Scene — River Crossing"
  basicTimeStep 32
  contactProperties [
    ContactProperties { material1 "hard_ground" coulombFriction 0.8 bumpSound "" rollSound "" slideSound "" }
    ContactProperties { material1 "mud_ground" coulombFriction 0.3 bumpSound "" rollSound "" slideSound "" }
    ContactProperties { material1 "gravel_ground" coulombFriction 0.5 bumpSound "" rollSound "" slideSound "" }
    ContactProperties { material1 "rubble_ground" coulombFriction 0.4 bumpSound "" rollSound "" slideSound "" }
    ContactProperties { material1 "water_ground" coulombFriction 0.1 bumpSound "" rollSound "" slideSound "" }
    ContactProperties { material1 "slope_ground" coulombFriction 0.6 bumpSound "" rollSound "" slideSound "" }
  ]
}

Viewpoint {
  orientation -0.2 -0.8 0.5 1.5
  position 0 20 15
}

Background {
  skyColor [ 0.4 0.6 0.9 ]
}

DEF SUN DirectionalLight {
  direction -0.5 -0.8 -1
  intensity 1.0
  castShadows TRUE
}

DEF FOG Fog {
  fogType "EXPONENTIAL"
  visibilityRange 0
  color 0.7 0.7 0.7
}

# ============================================================
# 底板 — 品红色警示层（地形边界标记）
# 颜色(0.85,0.12,0.55)与所有7类地形形成鲜明对比
# 地形块之间的缝隙和地图边缘会显露此色，提供边界判断线索
# ============================================================
Solid {
  translation 0 0 -0.25
  name "base_floor"
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.85 0.12 0.55 } }
      geometry Box { size 50 50 0.05 }
    }
  ]
  boundingObject Box { size 50 50 0.05 }
}

